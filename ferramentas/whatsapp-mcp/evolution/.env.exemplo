# Copie para .env (que NÃO vai para o Git) e preencha. Gere valores longos e aleatórios,
# por exemplo com: python3 -c "import secrets; print(secrets.token_hex(24))"
AUTHENTICATION_API_KEY=
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=
SERVER_URL=http://localhost:8080
