table _Medidas
	lineageTag: a603b870-74e3-5952-a614-0645d9a46150

	/// Voos que constavam na malha, cancelados ou não.
	measure 'Voos Programados' = SUM ( fato_operacao[voos_programados] )
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 7cf9e76d-d891-584b-ab39-7140daaa815b

	/// Voos programados que não decolaram.
	measure 'Voos Cancelados' = SUM ( fato_operacao[voos_cancelados] )
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 005fac14-493c-55d6-9b4a-cfd1d68e7bcd

	/// Voos que decolaram (programados menos cancelados).
	measure 'Voos Realizados' = SUM ( fato_operacao[voos_realizados] )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 550c71e3-ba1c-54f5-972e-b6e846bb51b4

	/// Voos realizados cujo horário real de saída foi registrado.
	measure 'Voos Com Horário' = [Voos Realizados] - [Voos Sem Horário]
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 500ecf1b-8fae-5a10-b8ff-ca55f7c23734

	/// Voos com horário registrado que saíram mais de 15 min depois do previsto.
	measure 'Voos Atrasados 15' = SUM ( fato_operacao[voos_atrasados_15] )
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 316a81f9-d906-5076-94fc-c8811b6641a3

	/// Voos com horário registrado que saíram mais de 60 min depois do previsto (atraso grave).
	measure 'Voos Atrasados 60' = SUM ( fato_operacao[voos_atrasados_60] )
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 370069eb-972d-5442-9fd5-b8731cd8b4c8

	/// Soma dos minutos de atraso dos voos atrasados (mais de 15 min).
	measure 'Minutos de Atraso' = SUM ( fato_operacao[minutos_atraso] )
		formatString: #,0
		isHidden
		displayFolder: 1 Volume
		lineageTag: 30d31eb9-e9d7-549a-a2fc-1cf904a6ae3f

	/// Parte dos voos programados que foi cancelada.
	measure 'Taxa de Cancelamento' = DIVIDE ( [Voos Cancelados], [Voos Programados] )
		formatString: 0.0%
		displayFolder: 3 Comparação
		lineageTag: 11bdc23f-f139-56ce-83d1-5415df9d8430

	/// Parte dos voos com horário registrado que atrasou mais de 15 min.
	measure 'Taxa de Atraso 15' = DIVIDE ( [Voos Atrasados 15], [Voos Com Horário] )
		formatString: 0.0%
		displayFolder: 3 Comparação
		lineageTag: e597c8ce-fb57-5319-861d-cec9418602eb

	/// Parte dos voos com horário que atrasou mais de 60 min.
	measure 'Taxa de Atraso 60' = DIVIDE ( [Voos Atrasados 60], [Voos Com Horário] )
		formatString: 0.0%
		isHidden
		displayFolder: 3 Comparação
		lineageTag: 4e26be87-d700-50e6-9873-fa6f3dac2d23

	/// Quantos minutos, em média, atrasa um voo que atrasou.
	measure 'Atraso Médio dos Atrasados (min)' = DIVIDE ( [Minutos de Atraso], [Voos Atrasados 15] )
		formatString: 0.0
		isHidden
		displayFolder: 3 Comparação
		lineageTag: f95a63a6-f7b4-5b04-a08d-a49b4c099192

	/// Taxa de atraso de todos os aeroportos, no mesmo período, companhia e faixa de horário.
	measure 'Taxa de Atraso na Rede' =
			CALCULATE (
			    [Taxa de Atraso 15],
			    REMOVEFILTERS ( dim_aeroporto ),
			    REMOVEFILTERS ( dim_rota )
			)
		formatString: 0.0%
		isHidden
		displayFolder: 3 Comparação
		lineageTag: 96fd4715-076a-582c-9567-28d6226890d3

	/// Quantos pontos percentuais um aeroporto está acima (+) ou abaixo (-) da rede.
	measure 'Diferença para a Rede (p.p.)' =
			VAR t = [Taxa de Atraso 15]
			VAR r = [Taxa de Atraso na Rede]
			RETURN
			    IF ( NOT ISBLANK ( t ), ( t - r ) * 100 )
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		displayFolder: 3 Comparação
		lineageTag: 63fa9990-f425-5789-9099-6aa26681ce95

	/// A taxa de atraso, mas só onde há volume suficiente para ela significar algo.
	measure 'Taxa de Atraso (volume mínimo)' =
			VAR minimo = SELECTEDVALUE ( 'Param Volume Minimo'[Value], 10000 )
			RETURN
			    IF ( [Voos Realizados] >= minimo, [Taxa de Atraso 15] )
		formatString: 0.0%
		displayFolder: 3 Comparação
		lineageTag: 04247c9e-fff1-583f-9dbc-9eede951ad14

	/// Posição do aeroporto entre os que têm volume mínimo (1 = maior taxa de atraso).
	measure 'Ranking de Aeroporto' =
			IF (
			    NOT ISBLANK ( [Taxa de Atraso (volume mínimo)] ),
			    RANKX (
			        FILTER (
			            ALLSELECTED ( dim_aeroporto[iata] ),
			            NOT ISBLANK ( [Taxa de Atraso (volume mínimo)] )
			        ),
			        [Taxa de Atraso (volume mínimo)],
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: 0
		isHidden
		displayFolder: 3 Comparação
		lineageTag: 41a2e2ce-f51f-50f2-a554-f655ccb72cd8

	/// Crescimento do número de voos realizados contra o mesmo período do ano anterior.
	measure 'Variação de Voos vs Ano Anterior (%)' =
			VAR atual = [Voos Realizados]
			VAR anterior =
			    CALCULATE ( [Voos Realizados], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), DIVIDE ( atual - anterior, anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 2 Tempo
		lineageTag: e0d71193-84ad-5065-ac0d-89d5cac3a8ef

	/// Quantos pontos percentuais a taxa de atraso subiu ou caiu contra o mesmo período do ano anterior.
	measure 'Variação da Taxa de Atraso vs Ano Anterior (p.p.)' =
			VAR atual = [Taxa de Atraso 15]
			VAR anterior =
			    CALCULATE ( [Taxa de Atraso 15], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), ( atual - anterior ) * 100 )
		formatString: +0.0;-0.0;0.0
		isHidden
		displayFolder: 2 Tempo
		lineageTag: 07791032-bc4d-5ca8-ae20-5d79f7d62c29

	/// Taxa de atraso dos 3 meses que terminam no mês do contexto.
	measure 'Taxa de Atraso (média móvel 3M)' =
			VAR fim = MAX ( dim_calendario[inicio_mes] )
			VAR janela =
			    FILTER (
			        ALL ( dim_calendario ),
			        dim_calendario[data] >= EDATE ( fim, -2 )
			            && dim_calendario[data] <= EOMONTH ( fim, 0 )
			    )
			RETURN
			    CALCULATE ( DIVIDE ( [Voos Atrasados 15], [Voos Com Horário] ), janela )
		formatString: 0.0%
		displayFolder: 2 Tempo
		lineageTag: 7a57d563-4474-5b89-bfb0-d2495b83154a

	/// Devolve a taxa de atraso só nos meses que têm um evento operacional; nos outros fica vazio.
	measure 'Marcador de Evento (série)' =
			VAR m = MAX ( dim_calendario[inicio_mes] )
			VAR temEvento =
			    COUNTROWS (
			        FILTER (
			            dim_evento,
			            dim_evento[tipo] = "Operacional"
			                && dim_evento[mes_inicio] <= m
			                && dim_evento[mes_fim] >= m
			        )
			    ) > 0
			RETURN
			    IF ( temEvento, [Taxa de Atraso 15] )
		formatString: 0.0%
		displayFolder: 2 Tempo
		lineageTag: bfe907d8-edb2-5131-ad9a-bd7c5d280da5

	/// Voos realizados sem horário real registrado (atraso desconhecido).
	measure 'Voos Sem Horário' = SUM ( fato_operacao[voos_sem_horario] )
		formatString: #,0
		isHidden
		displayFolder: 4 Qualidade do dado
		lineageTag: 6ddc2776-a868-537a-93e1-49337ec4c5fa

	/// Parte dos voos realizados sem horário registrado.
	measure '% de Voos Sem Horário' = DIVIDE ( [Voos Sem Horário], [Voos Realizados] )
		formatString: 0.0%
		displayFolder: 4 Qualidade do dado
		lineageTag: 9f0159db-63d6-5704-b727-01a975f41a65

	/// Taxa de atraso se TODO voo sem horário tivesse saído no prazo.
	measure 'Taxa de Atraso (limite inferior)' = DIVIDE ( [Voos Atrasados 15], [Voos Realizados] )
		formatString: 0.0%
		displayFolder: 4 Qualidade do dado
		lineageTag: b705df16-70a0-57de-a346-8ed68bef46b0

	/// Taxa de atraso se TODO voo sem horário tivesse atrasado.
	measure 'Taxa de Atraso (limite superior)' = DIVIDE ( [Voos Atrasados 15] + [Voos Sem Horário], [Voos Realizados] )
		formatString: 0.0%
		displayFolder: 4 Qualidade do dado
		lineageTag: cb469cb2-cd75-50d4-aa0b-2a340be53d73

	/// Frase de abertura da página 1, que muda com os filtros.
	measure Narrativa =
			VAR t = [Taxa de Atraso 15]
			VAR noite = CALCULATE ( [Taxa de Atraso 15], dim_faixa_horario[faixa] = "Noite" )
			VAR manha = CALCULATE ( [Taxa de Atraso 15], dim_faixa_horario[faixa] = "Manhã" )
			VAR canc = [Taxa de Cancelamento]
			RETURN
			    "De cada 100 voos com horário registrado, " & FORMAT ( t * 100, "0.0" )
			        & " saíram mais de 15 min depois do previsto. De manhã são "
			        & FORMAT ( manha * 100, "0.0" ) & "; à noite, " & FORMAT ( noite * 100, "0.0" )
			        & ". Cancelamos " & FORMAT ( canc * 100, "0.0" ) & "% dos voos programados."
		displayFolder: 3 Comparação
		lineageTag: 4d122b61-8903-592d-9ded-de241632dedf

	/// Valor de cada degrau do funil (programados até atrasados graves).
	measure 'Valor da Etapa' =
			SWITCH (
			    SELECTEDVALUE ( Etapas[Ordem] ),
			    1, [Voos Programados],
			    2, [Voos Realizados],
			    3, [Voos Com Horário],
			    4, [Voos Atrasados 15],
			    5, [Voos Atrasados 60]
			)
		formatString: #,0
		displayFolder: 3 Comparação
		lineageTag: 64d62bd8-11bb-5edb-9a07-de5776882ccb

	column Coluna
		dataType: string
		isHidden
		lineageTag: ebcd0c5a-f281-52c7-834a-0942103f9bcc
		summarizeBy: none
		sourceColumn: Coluna

	partition _Medidas = m
		mode: import
		source =
			let
			    Fonte = #table ( type table [Coluna = text], {} )
			in
			    Fonte
